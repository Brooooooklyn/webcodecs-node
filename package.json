{
  "name": "@napi-rs/webcodecs",
  "version": "1.4.0",
  "description": "WebCodecs API implementation for Node.js using FFmpeg",
  "keywords": [
    "N-API",
    "NAPI",
    "Rust",
    "napi-rs",
    "node-addon",
    "node-addon-api"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Brooooooklyn/webcodecs-node.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Brooooooklyn"
  },
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    },
    "./polyfill": {
      "types": "./polyfill.d.ts",
      "import": "./polyfill.js",
      "require": "./polyfill.js"
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "polyfill.d.ts",
    "polyfill.js",
    "standard.d.ts"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/compare.ts",
    "build": "oxnode ./build.ts --platform --release",
    "build:debug": "oxnode ./build.ts --platform",
    "format": "run-p format:rs format:oxfmt",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "lint": "oxlint --type-aware",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "demo": "cd example && vite",
    "typecheck": "tsc -b tsconfig.json && tsc --ignoreConfig ./index.d.ts",
    "preversion": "oxnode ./build.ts --platform && git add .",
    "version": "napi version"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ]
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@napi-rs/canvas": "^1.0.5",
    "@napi-rs/cli": "^3.8.4",
    "@napi-rs/wasm-runtime": "^1.2.2",
    "@oxc-node/cli": "^0.1.0",
    "@oxc-node/core": "^0.1.0",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.3",
    "@types/node": "^26.2.0",
    "ava": "^8.0.1",
    "chalk": "^6.0.0",
    "emnapi": "^1.11.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mediabunny": "1.55.7",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "tinybench": "^6.1.2",
    "typescript": "^7.0.2",
    "webcodecs-polyfill": "^1.0.1",
    "vite-plugin-mkcert": "^2.1.0"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    }
  },
  "napi": {
    "binaryName": "webcodecs",
    "constEnum": false,
    "dtsHeaderFile": "dts-header.d.ts",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf"
    ]
  },
  "packageManager": "pnpm@11.25.0",
  "ava": {
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    },
    "extensions": [
      "ts"
    ],
    "files": [
      "__test__/**/*.spec.ts"
    ],
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ],
    "timeout": "5m",
    "workerThreads": false
  },
  "engines": {
    "node": "^22.20 || ^24.12 || >=25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
